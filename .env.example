# Database
DB_HOST=localhost
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=aar9speed

# Items at or below this quantity count as low stock
LOW_STOCK_THRESHOLD=5

# Automations (see README → Automation)
# Bot token from @BotFather, and the chat ID of the owner or a group
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Long random string that protects cron.php, e.g. output of: php -r "echo bin2hex(random_bytes(24));"
CRON_SECRET=
APP_TIMEZONE=Asia/Manila
# 24-hour time; the report is sent on the first scheduler run at or after this time
DAILY_REPORT_TIME=21:00
SCHEDULER_INTERVAL_MINUTES=5
