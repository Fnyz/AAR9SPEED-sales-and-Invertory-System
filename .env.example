# Database
DB_HOST=localhost
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=aar9speed

# Items at or below this quantity count as low stock, unless the product has
# its own reorder level (set on the Products page)
LOW_STOCK_THRESHOLD=5

# Staff are signed out after this many minutes without using the app (minimum 5)
SESSION_IDLE_MINUTES=30

# Automations (see README → Automation)
# Where alerts and the daily report go. Set Discord, Telegram, or both.
# Discord: channel → Edit Channel → Integrations → Webhooks → New Webhook → Copy Webhook URL
DISCORD_WEBHOOK_URL=
# Set to 1 on hosts that block outgoing connections (e.g. InfinityFree free plan):
# Discord messages are then posted by a signed-in staff browser instead of the server.
NOTIFY_VIA_BROWSER=0
# Telegram: bot token from @BotFather, and the chat ID of the owner or a group
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Long random string that protects cron.php, e.g. output of: php -r "echo bin2hex(random_bytes(24));"
CRON_SECRET=
APP_TIMEZONE=Asia/Manila
# 24-hour time; the report is sent on the first scheduler run at or after this time
DAILY_REPORT_TIME=21:00
SCHEDULER_INTERVAL_MINUTES=5
