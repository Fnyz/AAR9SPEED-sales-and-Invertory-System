# Uploaded product photos only: never run scripts from this folder.
<FilesMatch "\.(php[0-9]?|phtml|phar|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>
# Only -Indexes here: InfinityFree answers every request in this folder with a
# 500 error if .htaccess changes ExecCGI. The FilesMatch rule above already
# stops scripts from running.
Options -Indexes
